{
  "name": "quotaview-windows",
  "productName": "QuotaView Windows",
  "version": "0.8.3-win.1.effects.2",
  "description": "Windows Dynamic Island for local coding agents",
  "main": "src/main.cjs",
  "author": "Duoasa",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:helper": "node scripts/build-helper.cjs",
    "test": "node --test ../ElectronEffects/tests/model.test.cjs tests/*.test.cjs",
    "start": "pnpm run build && electron .",
    "smoke": "electron . --smoke-test",
    "package": "pnpm run build && pnpm run build:helper && electron-builder --win --x64 --dir --publish never",
    "dist": "pnpm run build && pnpm run build:helper && electron-builder --win nsis portable --x64 --publish never",
    "test:renderer": "node scripts/renderer-smoke.cjs",
    "test:helper": "node --test tests/native-helper.test.cjs",
    "size": "node scripts/package-size.cjs"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  },
  "build": {
    "appId": "com.duoasa.quotaview.windows",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "dist/renderer/**",
      "dist/assets/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "shared/**"
    ],
    "extraResources": [
      {
        "from": "dist/helper",
        "to": "helper"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "artifactName": "QuotaView-Windows-${version}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "QuotaView-Windows-${version}-${arch}-Setup.${ext}",
      "include": "native/installer.nsh"
    },
    "portable": {
      "artifactName": "QuotaView-Windows-${version}-${arch}-Portable.${ext}"
    }
  }
}
